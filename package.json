  "description": "Base nodes of n8n",
  "private": true,
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && gulp build:icons && gulp build:translations && pnpm build:metadata",
    "build:unchecked": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && gulp build:icons && gulp build:translations",
    "build:watch": "tsc -p tsconfig.build.json --watch & tsc-alias -p tsconfig.build.json --watch & gulp build:icons && gulp build:translations",
    "build:icons": "gulp build:icons",
    "build:translations": "gulp build:translations",
    "build:metadata": "pnpm n8n-generate-known && pnpm n8n-generate-ui-types || true",
    "format": "prettier --write . --ignore-path ../../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../../.prettierignore",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:unit": "jest",
    "test:integration": "jest --testMatch=\"<rootDir>/test/integration/**/*.test.ts\"",
    "watch": "tsc -p tsconfig.build.json --watch"
  },
